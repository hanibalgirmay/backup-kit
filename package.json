{
  "name": "backup-kit-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo root — not published. Publish packages/* separately.",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm --filter backup-kit build",
    "test": "pnpm --filter backup-kit test",
    "typecheck": "pnpm --filter backup-kit typecheck",
    "test:nodejs": "pnpm --filter backup-kit test",
    "test:php": "composer test --working-dir=packages/php",
    "test:python": "python -m pytest packages/python/tests",
    "test:go": "go -C packages/go test ./...",
    "test:all": "pnpm test:nodejs && pnpm test:php && pnpm test:python && pnpm test:go",
    "publish:nodejs": "pnpm --filter backup-kit publish --access public"
  }
}
