# Copy to .env for local experiments — never commit real secrets.

# Database (auto-discovery)
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/app
# MONGODB_URI=mongodb://127.0.0.1:27017/app
# REDIS_URL=redis://127.0.0.1:6379/0

# Optional discrete DB_* (Laravel-style)
# DB_CONNECTION=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=app
# DB_USERNAME=user
# DB_PASSWORD=

# Remote storage examples
# SSH_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
